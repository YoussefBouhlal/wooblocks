<?xml version="1.0"?>
<ruleset name="WooBlocks">
	<description>WordPress standards for theme PHP source.</description>
	<file>functions.php</file>
	<file>patterns</file>
	<arg name="extensions" value="php"/>
	<arg value="ps"/>
	<rule ref="WordPress"/>
	<config name="text_domain" value="wooblocks"/>
	<config name="prefixes" value="wooblocks"/>
</ruleset>
